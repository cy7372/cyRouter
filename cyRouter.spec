# -*- mode: python ; coding: utf-8 -*-
"""PyInstaller spec for cyRouter.

Build:  pyinstaller cyRouter.spec
Output: dist/cyRouter.exe (onefile, no console window)
"""

import sys
from pathlib import Path

block_cipher = None

# Project root (where this spec lives)
ROOT = Path(SPECPATH)

datas = [
    # (source, dest_dir) — web UI must ship inside the bundle
    (str(ROOT / "web"), "web"),
]

# cryptography uses lazy imports for its backends; pystray pulls win32 APIs.
binaries = []

hiddenimports = [
    # cyRouter internal modules (must be explicit for PyInstaller)
    "reasoning",
    "stats",
    "config",
    "router",
    "breaker",
    "cache",
    "redact",
    "version",
    "providers.base",
    "providers.openai",
    "providers.claude",
    # cryptography.backends (loaded via importlib.metadata entrypoints)
    "cryptography",
    "cryptography.fernet",
    "cryptography.hazmat.backends",
    "cryptography.hazmat.backends.openssl.backend",
    "cryptography.hazmat.bindings._rust",
    # uvicorn extras — standard pulls these but PyInstaller may miss them
    "uvicorn",
    "uvicorn.logging",
    "uvicorn.loops",
    "uvicorn.loops.auto",
    "uvicorn.loops.asyncio",
    "uvicorn.protocols",
    "uvicorn.protocols.http",
    "uvicorn.protocols.http.auto",
    "uvicorn.protocols.http.h11_impl",
    "uvicorn.protocols.websockets",
    "uvicorn.protocols.websockets.auto",
    "uvicorn.lifespan",
    "uvicorn.lifespan.on",
    # FastAPI / Starlette
    "fastapi",
    "starlette",
    "starlette.responses",
    "starlette.middleware",
    # httpx ships http1 by default; http2 extras not used by cyRouter
    # pystray + Pillow on Windows
    "pystray",
    "pystray._win32",
    "PIL",
    "PIL.Image",
    "PIL.ImageDraw",
    # Encoders for OpenAI/Anthropic SDKs
    "openai",
    "anthropic",
    # stdlib modules that PyInstaller sometimes misses
    "email.mime.text",
    "email.mime.multipart",
]

a = Analysis(
    [str(ROOT / "launcher.py")],
    pathex=[str(ROOT)],
    binaries=binaries,
    datas=datas,
    hiddenimports=hiddenimports,
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=[
        # Trim unused heavy modules to shrink the bundle
        "tkinter",
        "matplotlib",
        "numpy",
        "pandas",
        "scipy",
        "PyQt5",
        "PyQt6",
        "PySide2",
        "PySide6",
        "IPython",
        "jupyter",
        "notebook",
    ],
    win_no_prefer_redirects=False,
    win_private_assemblies=False,
    cipher=block_cipher,
    noarchive=False,
)

pyz = PYZ(a.pure, a.zipped_data, cipher=block_cipher)

# Optional Windows version resource (VS_VERSION_INFO). Generated by
# build.ps1 from version.py; falls back to None if absent (e.g. bare
# `pyinstaller cyRouter.spec` without the build script).
_version_file = str(ROOT / "packaging" / "version_info.txt")
if not Path(_version_file).exists():
    _version_file = None

exe = EXE(
    pyz,
    a.scripts,
    a.binaries,
    a.zipfiles,
    a.datas,
    [],
    name="cyRouter",
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=True,
    upx_exclude=[],
    runtime_tmpdir=None,
    console=False,          # GUI-like: no console window
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
    # Use the cyRouter logo (matches web favicon) as the exe icon
    icon=str(ROOT / "packaging" / "cyrouter.ico"),
    # Embed Windows version resource (VS_VERSION_INFO) so "Right-click →
    # Properties → Details" shows the four-segment version. Parameter name
    # is `version` in PyInstaller 6.x (was `version_file` in 5.x).
    version=_version_file,
)
